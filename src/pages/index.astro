---
// src/pages/index.astro

// 1. Detectar el idioma preferido del navegador del usuario
const acceptLanguage = Astro.request.headers.get('accept-language') || '';
const preferredLanguage = acceptLanguage.split(',')[0].substring(0, 2);

// 2. Definir tu idioma por defecto si no es español ni inglés
const defaultLanguage = 'en';
const supportedLanguages = ['es', 'en'];

const finalLanguage = supportedLanguages.includes(preferredLanguage) 
  ? preferredLanguage 
  : defaultLanguage;

// 3. Redireccionar al usuario a /es/ o /en/
return Astro.redirect(`/${finalLanguage}/`);
---

