---
import { t } from "../i18n/utils";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
---

<header id="header">
    <div id="logo">
        <p>DEV.DIEGOPARRADO</p>
    </div>

    <div id="content">
        <ul>
            <li><a href={`/${lang}#about`}>{t(lang, "header.about")}</a></li>
            <li><a href={`/${lang}#skills`}>{t(lang, "header.skills")}</a></li>
            <li>
                <a href={`/${lang}#projects`}>{t(lang, "header.projects")}</a>
            </li>
            <li>
                <a href={`/${lang}#contact`}>{t(lang, "header.contact")}</a>
            </li>
        </ul>
    </div>

    <div class="controls-wrapper">
        <!-- Language Switcher -->
        <div class="language-switcher">
            <a
                href="/es/"
                class={`lang-btn ${lang === "es" ? "active" : ""}`}
                aria-label="Cambiar a Español"
            >
                ES
            </a>
            <span class="lang-separator">·</span>
            <a
                href="/en/"
                class={`lang-btn ${lang === "en" ? "active" : ""}`}
                aria-label="Switch to English"
            >
                EN
            </a>
        </div>

        <!-- Theme Toggle -->
        <input type="checkbox" id="theme-toggle" class="theme-checkbox" />
        <label
            for="theme-toggle"
            class="theme-label"
            aria-label="Cambiar modo de color"
        >
            <span class="sun">☀️</span>
            <span class="moon">🌙</span>
        </label>
    </div>
</header>

<style>
    #header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background-color: var(--neutral);
        z-index: 1000;
        border-bottom: 1px solid var(--neutral-2);

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        align-items: center;
        padding: 0 5%;
        box-sizing: border-box;
    }

    #logo {
        display: flex;
        align-items: center;
    }

    #logo p {
        margin: 0;
        font-size: var(--font-size-sm);
        font-family: "Geist", sans-serif;
        font-weight: bold;
        color: var(--neutral-9);
    }

    #content {
        display: flex;
        justify-content: center;
    }

    #content ul {
        display: flex;
        flex-direction: row;
        gap: 20px;
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

    #content ul a {
        text-decoration: none;
        font-family: "Inter", sans-serif;
        font-size: var(--font-size-sm);
        color: var(--neutral-9);
        transition: color 0.2s ease;
    }

    #content ul a:hover {
        color: var(--primary-8);
    }

    /* --- CONTROLS WRAPPER (Language + Theme) --- */
    .controls-wrapper {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 1.5rem;
    }

    /* --- LANGUAGE SWITCHER --- */
    .language-switcher {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: "Jetbrains Mono", monospace;
        font-size: 0.9rem;
    }

    .lang-btn {
        padding: 0.4rem 0.8rem;
        text-decoration: none;
        color: var(--neutral-7);
        border: 1px solid transparent;
        border-radius: 4px;
        transition: all 0.2s ease;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .lang-btn:hover {
        color: var(--neutral-9);
        border-color: var(--primary-8);
    }

    .lang-btn.active {
        color: var(--primary-8);
        border-color: var(--primary-8);
        background-color: rgba(173, 198, 255, 0.05);
    }

    .lang-separator {
        color: var(--neutral-5);
        font-weight: bold;
    }

    /* --- THEME TOGGLE --- */
    .theme-checkbox {
        opacity: 0;
        position: absolute;
        pointer-events: none;
    }

    .theme-label {
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        padding: 5px;
        position: relative;
        font-size: 1.5rem;
        user-select: none;
        transition: all 0.2s ease;
    }

    .sun {
        display: block;
    }

    .moon {
        display: none;
    }

    .theme-checkbox:checked + .theme-label .sun {
        display: none;
    }

    .theme-checkbox:checked + .theme-label .moon {
        display: block;
    }

    /* --- RESPONSIVE --- */
    @media (max-width: 768px) {
        #header {
            grid-template-columns: 1fr auto;
            padding: 0 3%;
        }

        #content {
            display: none;
        }

        .controls-wrapper {
            gap: 1rem;
        }

        .language-switcher {
            gap: 0.5rem;
        }

        .lang-btn {
            padding: 0.35rem 0.6rem;
            font-size: 0.85rem;
        }
    }
</style>
