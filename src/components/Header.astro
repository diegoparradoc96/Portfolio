---
import "../styles/global.css";
---

<header id="header">
    <div id="logo">
        <p>DEV.DIEGOPARRADO</p>
    </div>

    <div id="content">
        <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </div>
</header>

<style>
    #header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background-color: var(--neutral);
        display: flex;
        align-items: center;
        z-index: 1000;
    }
    #logo {
        width: 50%;
        padding-left: 5%;
    }
    #logo p {
        margin: 0;
        font-size: 18px;
        font-family: "Geist";
        font-weight: bold;
        color: var(--neutral-9);
    }
    #content {
        display: flex;
        justify-content: flex-end;
        width: 50%;
        padding-right: 5%;
    }
    #content ul {
        display: flex;
        flex-direction: row;
        gap: 20px;
    }
    #content ul a {
        text-decoration: none;
        font-family: "Inter";
        color: var(--neutral-9);
    }
    #content ul a:hover {
        color: var(--neutral-7);
    }
</style>
