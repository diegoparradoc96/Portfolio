---
import { t } from "../i18n/utils";
import { getCollection, type CollectionEntry } from "astro:content";

/* props */
interface Props {
    lang: string;
}

/* types */
type Project = CollectionEntry<"projects">;

const { lang } = Astro.props;

const projects = await getCollection("projects");
const filteredProjects = projects.filter((p: Project) => p.data.lang === lang);
console.log("projects", projects);
console.log("filteredProjects", filteredProjects);
---

<section class="projects-section">
    <h2 class="projects-title">{t(lang, "projects.title")}</h2>

    <div class="projects-grid">
        {
            filteredProjects.map((project: Project) => (
                <article class="card">
                    <div id="image-container">
                        <img
                            src={project.data.image}
                            alt={project.data.title}
                            id="image"
                        />
                    </div>
                    <div id="title-container">
                        <h2 id="title">{project.data.title}</h2>
                        <span id="title-icon" class="material-symbols-outlined">arrow_outward</span>
                    </div>
                    <p id="description">{project.data.description}</p>
                    <div class="tags">
                        {project.data.tags.map((tag: string, index: number) => {
                            if (index < project.data.tags.length - 1) {
                                return (<span id="tag">{tag}</span> <span id="floating-point"> · </span> )
                            } else {
                                return <span id="tag">{tag}</span>;
                            }
                        })}
                    </div>                    
                </article>
            ))
        }
    </div>
</section>

<style>
    .projects-section {
        padding-top: 80px;
        margin-bottom: 80px;
    }

    .projects-title {
        font-size: var(--font-size-lg2);
        font-family: "Inter";
        color: var(--neutral-9);
        margin-bottom: 10px;
        
    }

    .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        border-bottom: 1px solid #333;
        border-top: 1px solid #333;
        padding-top: 3rem;
        padding-bottom: 5rem;
    }

    /* Equivale a md:grid-cols-2 */
    @media (min-width: 768px) {
        .projects-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .card {
        width: 100%;
        height: 100%;
        object-fit: cover;
        color: var(--neutral-9);
        cursor: pointer;
    }

    #image-container {
        width: 100%;
        height: auto;
        overflow: hidden;
        border-radius: 10px;
        margin-bottom: 16px;
        border: 0.5px solid #333;
        transition: all 200ms ease-in-out;
    }

    .card:hover #image-container {
        border: 0.5px solid var(--primary-8)
        ;
    }

    #image {
        width: 100%;        
        height: auto;        
        opacity: 0.9;
        transition: all 200ms ease-in-out;
        display: block;
    }

    .card:hover #image {
        opacity: 1;
        transform: scale(1.05);
    }

    #title-container {
        display: grid;
		grid-template-columns: 1.9fr 0.1fr;
    }

    #title {
        font-family: "Geist";
        font-size: var(--font-size-lg);
        margin-top: 0px;
        margin-bottom: 0px;
        transition: all 200ms ease-in-out;
    }

    #title-icon {
        margin: 0px auto;
        /* transition: all 200ms ease-in-out; */
    }

    .card:hover #title-icon {
        transform: translate(5px, -5px);
        color: var(--primary-8);
    }

    .card:hover #title {
        color: var(--primary-8);
    }

    #description {
        color: var(--neutral-8);
        font-family: "Inter";
        font-size: var(--font-size-md);
        margin-top: 10px;
        
    }

     #tag {
        color: var(--neutral-8);
        font-family: "Jetbrains Mono";
        font-size: var(--font-size-sm);
    }
    
    #floating-point {
        color: var(--neutral-5);
        font-weight: bold;
        font-size: var(--font-size-sm);
        margin-left: 10px;
        margin-right: 10px;        
    }
</style>
