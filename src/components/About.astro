---
import { t } from "../i18n/utils";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
---

<div class="intro-card">
    <h2 class="intro-title">{t(lang, "about.title")}</h2>

    <p class="intro-description">
        {t(lang, "about.description")}
    </p>

    <div class="location">
        <span class="material-symbols-outlined"> location_on </span>
        {t(lang, "about.location")}
    </div>
</div>

<style>
    /* about and location */
    .about {
        margin-top: 60px;
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 16px;
    }

    .intro-card {
        /* background-color: #1e1e1e; */
        border: 1px solid var(--neutral-2);
        background-color: var(--neutral-1);
        border-radius: 16px;
        padding: 4rem;
        transition: all 0.3s ease;
    }

    .intro-description {
        margin: 0 0 20px;
        color: var(--neutral-9);
        line-height: 1.7;
        font-size: var(--font-size-md);
    }

    .intro-title {
        margin: 0 0 12px;
        font-size: var(--font-size-lg);
        font-weight: 700;
        color: var(--neutral-9);
    }

    .intro-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary-8);
    }

    .location {
        font-family: "Jetbrains Mono";
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--primary-8);
        font-size: var(--font-size-sm);
        font-weight: 600;
    }

    .location-icon {
        font-size: 20px;
    }
</style>
