---
import "../styles/global.css";
---

<section class="hero">
    <div class="hero-glow"></div>

    <h1 class="hero-title">
        Full-Stack<br />
        <span>Developer.</span>
    </h1>

    <p class="hero-description">
        Building robust, scalable applications with modern technologies.
        Bridging the gap between elegant UI and complex backend systems.
    </p>

    <div class="hero-buttons">
        <a href="#projects" class="btn btn-primary">
            View Projects
            <span class="icon">→</span>
        </a>

        <a href="#contact" class="btn btn-secondary"> Contact Me </a>
    </div>
</section>

<style>
    :root {
        --primary: #6366f1;
        --on-primary: #ffffff;
        --text: #f5f5f5;
        --text-secondary: #a1a1aa;
        --border: #3f3f46;
        --background: #09090b;
    }

    body {
        margin: 0;
        background: var(--neutral);
        font-family: Arial, sans-serif;
    }

    .hero {
        position: relative;
        min-height: 900px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0 20px;
        text-align: center;
        overflow: hidden;
    }

    .hero-glow {
        position: absolute;
        width: 440px;
        height: 440px;
        background: rgba(143, 146, 212, 0.2);
        border-radius: 50%;
        filter: blur(100px);
        z-index: -1;
    }

    .hero-title {
        font-family: "Geist";
        font-size: clamp(3rem, 8vw, 5rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -2px;
        color: var(--text);
        margin-bottom: 1rem;
    }

    .hero-title span {
        color: var(--primary-8);
    }

    .hero-description {
        max-width: 700px;
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 16px 36px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: 500;
        letter-spacing: 0.7px;
        font-size: 1rem;
        font-family:
            Jetbrains Mono,
            monospace;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: var(--primary-8);
        color: var(--neutral-2);
    }

    .btn-primary:hover {
        opacity: 0.9;
    }

    .btn-secondary {
        border: 1px solid var(--border);
        color: var(--text);
    }

    .btn-secondary:hover {
        border-color: var(--primary-8);
        color: var(--primary-8);
        background: rgba(99, 102, 241, 0.05);
    }

    .icon {
        font-size: 18px;
    }

    /* Responsive */
    @media (max-width: 640px) {
        .hero-buttons {
            flex-direction: column;
            width: 100%;
            max-width: 300px;
        }

        .btn {
            width: 100%;
        }
    }
</style>
